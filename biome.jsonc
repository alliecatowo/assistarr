{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "!node_modules",
      "!.next",
      "!ai-sdk",
      "!components/ui",
      "!lib/utils.ts",
      "!hooks/use-mobile.ts"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedAttributes": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noUnknownAtRules": "off",
        "noConsole": "warn",
        "noBitwiseOperators": "off",
        "noLeakedRender": "off",
        "noShadow": "off",
        "noNestedPromises": "off",
        "noEmptyBlockStatements": "off",
        "noUnusedExpressions": "off",
        "noUnnecessaryConditions": "off"
      },
      "style": {
        "useErrorCause": "off",
        "useConsistentMethodSignatures": "off",
        "noDescendingSpecificity": "off",
        "noIncrementDecrement": "off",
        "useConsistentArrowReturn": "off",
        "useDestructuring": "off",
        "noMagicNumbers": "off",
        "noNestedTernary": "off",
        "useConsistentTypeDefinitions": "off",
        "noParameterProperties": "off",
        "useConsistentMemberAccessibility": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useSimplifiedLogicExpression": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off",
        "useImageSize": "off"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off",
        "noBarrelFile": "off",
        "useTopLevelRegex": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "tests/**", "**/*.stories.tsx"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
